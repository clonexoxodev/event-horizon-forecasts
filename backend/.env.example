# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# Supabase Configuration
# Required for auth, wallet, market, admin, and notification APIs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/prediction_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prediction_platform
DB_USER=user
DB_PASSWORD=password

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# AWS S3 Configuration (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=prediction-platform-uploads

# Currency Conversion API
EXCHANGE_API_URL=https://api.exchangerate-api.io/v4/latest
EXCHANGE_API_KEY=your-api-key
