# Server Configuration
PORT=5004
NODE_ENV=development
# Local development frontend:
FRONTEND_URL=http://127.0.0.1:8081

# Production backend on Vercel:
# FRONTEND_URL=https://event-horizon-forecasts.vercel.app

# Supabase Configuration
# Required for auth, wallet, market, admin, and notification APIs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
USE_SUPABASE_ONLY=true

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/prediction_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prediction_platform
DB_USER=user
DB_PASSWORD=password

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# AWS S3 Configuration (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=prediction-platform-uploads

# Currency Conversion API
EXCHANGE_API_URL=https://api.exchangerate-api.io/v4/latest
EXCHANGE_API_KEY=your-api-key

# Payment Provider Configuration
# Which provider to use by default: 'paystack' | 'flutterwave' | 'monnify'
PAYMENT_PROVIDER=flutterwave

# Flutterwave (https://dashboard.flutterwave.com → Settings → API Keys)
FLUTTERWAVE_SECRET_KEY=FLWSECK_test_xxxxxxxxxxxxx
FLUTTERWAVE_SECRET_HASH=your_webhook_secret_hash_here

# Paystack (https://dashboard.paystack.com → Settings → API Keys)
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Monnify (https://monnify.com → Settings → API Keys)
# MONNIFY_API_KEY=MK_test_xxxxxxxxxxxxx
# MONNIFY_SECRET_KEY=xxxxxxxxxxxxxxxxx
# MONNIFY_CONTRACT_CODE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
