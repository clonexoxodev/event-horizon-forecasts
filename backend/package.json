{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run schema-constraints.property.test.ts",
    "test:setup": "node setup-test-db.js",
    "clear-test-users": "tsx src/scripts/clear-test-users.ts",
    "db:init": "tsx src/db/initialize.ts init",
    "db:drop": "tsx src/db/initialize.ts drop",
    "db:reset": "tsx src/db/initialize.ts reset",
    "db:migrate": "tsx src/db/migrations.ts migrate",
    "db:migrate:status": "tsx src/db/migrations.ts status",
    "db:migrate:rollback": "tsx src/db/migrations.ts rollback",
    "db:setup:full": "tsx src/db/setup.ts full",
    "db:setup:schema": "tsx src/db/setup.ts schema",
    "db:setup:sample": "tsx src/db/setup.ts sample",
    "db:verify": "tsx src/db/verify-schema.ts",
    "db:validate": "tsx src/db/validate-complete-setup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@supabase/supabase-js": "^2.105.3",
    "axios": "^1.6.5",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "socket.io": "^4.6.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "fast-check": "^3.15.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
